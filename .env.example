PORT=3000
BASE_URL=http://localhost:3000
DATA_DIR=./data
POLL_INTERVAL_MS=120000
# Configure a local event relay in Discord using /setsource
DISCORD_BOT_MODE=local
DISCORD_INVITE=https://discord.gg/unstableevents
DISCORD_MESSAGE_CONTENT_INTENT=false
DISCORD_CLIENT_ID=your_bot_application_id
DISCORD_BOT_TOKEN=replace_me
# Optional: leave empty to use verified public YouTube feeds
YOUTUBE_API_KEY=
# Optional: set these if you already have permanent VAPID keys.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
